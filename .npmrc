# Always install devDependencies, even when NODE_ENV=production is set in the
# environment.
#
# Why this file exists: NODE_ENV was set to "production" on the owner's Windows
# machine, which makes npm silently omit devDependencies. A fresh `npm ci` then
# produces a tree with next but without vitest, eslint, typescript or tsx — so
# `npm run verify` fails with "Cannot find package 'vitest'" and the project
# looks broken when only the install was.
#
# It fails quietly and confusingly, and it would hit anyone cloning this repo
# onto a machine configured the same way.
#
# This is safe here because nothing installs this project for production via
# npm. It runs with `npm run dev` on the owner's machine. Revisit when there is
# a real deployment (roadmap C2) — a server build should install dev
# dependencies to compile and then drop them, which is a deliberate step rather
# than an accident of an environment variable.
include=dev
