# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# local prototype database
/db/app.db

# misc
.DS_Store
*.pem

# leftover file-transfer bundle from the 2026-07-31 session — safe to delete
/_to_delete/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — .env.local holds the API key and must never be committed.
# .env.example is the blank template and SHOULD be committed.
.env*
!.env.example

# --- real client email, never leave this machine ---------------------------
# Anything under evals/cases/private/ is yours: real (redacted) emails from
# the agency's mailbox. It is deliberately excluded from git so that pushing
# to GitHub can never publish a client's name or property address.
# The example cases directly in evals/cases/ are made up and are committed.
/evals/cases/private/*
!/evals/cases/private/README.md
# The scorecard report is regenerated on every run and quotes real email.
/evals/last-run.md

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Exported test papers - contain the same real email as cases/private/
/evals/export/

# Stored email attachments - real client documents, never committed
/storage/

# Exported real email waiting to be imported (npm run import).
#
# THIS ONE MATTERS MORE THAN IT LOOKS. Every commit auto-pushes to GitHub
# (.githooks/post-commit), so an un-ignored folder of exported client mail
# would be published by the next commit anyone made, without anyone deciding
# to publish it. The instructions in inbox/README.md are committed; the
# messages themselves never are.
/inbox/*
!/inbox/README.md
