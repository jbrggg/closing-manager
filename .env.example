# ---------------------------------------------------------------------------
# Copy to `.env.local` and fill in as you enable each integration.
# Every value below is OPTIONAL — with none of them set, the app runs fully
# on the mock email provider + simulated AI provider, which is the default
# demo mode described in the README.
# ---------------------------------------------------------------------------

# --- AI provider ------------------------------------------------------------
# "simulated" (default) = deterministic rule-based engine, no network calls.
# "llm"                 = real Anthropic API calls via src/lib/ai/llm-provider.ts.
#                         Falls back to "simulated" if ANTHROPIC_API_KEY is unset.
AI_PROVIDER=simulated

# Required only when AI_PROVIDER=llm
ANTHROPIC_API_KEY=

# Optional. Check docs.claude.com for current model names — this one was
# verified current on 2026-07-31.
ANTHROPIC_MODEL=claude-sonnet-5


# --- Email provider ---------------------------------------------------------
# "mock" (default) = seeded mailbox in the app database.
# "microsoft" = real Outlook / Microsoft 365 via Graph. IMPLEMENTED but never
#               run against a live tenant — expect to debug the first connect.
#               Also requires completing OAuth at
#               /api/v1/integrations/microsoft/start
# "gmail"     = still a scaffold, NOT implemented.
# The factory falls back to mock with a console warning if a real provider is
# selected but not fully configured, so a half-finished setup degrades
# visibly instead of taking the app down.
EMAIL_PROVIDER=mock

# Gmail / Google Workspace (see setup checklist in gmail-provider.ts)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3000/api/v1/integrations/gmail/callback

# --- Microsoft 365 / Outlook (IMPLEMENTED, needs your Entra app) ----------
# Full setup steps are in the README under "Connecting Outlook".
# From Entra admin center → App registrations → your app:
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/v1/integrations/microsoft/callback

# Base URL used to build the OAuth redirect if MICROSOFT_REDIRECT_URI is unset.
APP_BASE_URL=http://localhost:3000

# REQUIRED before connecting any real mailbox — encrypts OAuth tokens at rest.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Back this up. Losing it means every connected mailbox must be reconnected.
APP_ENCRYPTION_KEY=


# --- Database ---------------------------------------------------------------
# The prototype uses local SQLite (db/app.db) via node:sqlite and ignores
# this value. It's here for the Postgres migration path described in the
# README — once you switch src/lib/db.ts to Prisma Client, this is what
# prisma/schema.prisma's datasource will read.
DATABASE_URL=postgresql://user:password@localhost:5432/closing_manager

# --- Which addresses are OURS -----------------------------------------------
# Comma-separated. Anything sent from these is OUTGOING; everything else is
# INCOMING. This is what makes forwarded mail work: when you forward a work
# email to a test inbox the envelope says YOU sent it, so without this every
# message would be filed as INCOMING and the AI would hunt your own sent mail
# for requests. See src/lib/email/forwarded.ts.
ORG_EMAIL_DOMAINS=
# Optional: staff on a different domain, listed individually.
ORG_EMAIL_ADDRESSES=
# Optional: the address the app should treat as its own mailbox on import.
ORG_MAILBOX_ADDRESS=
